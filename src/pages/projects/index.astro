---
import CrtLayout from '@/layouts/CrtLayout.astro';
import { PROJECTS } from '@/data/projects';
---

<CrtLayout
  title="Oneadto"
  activeNav="projects"
  defaultBranch="作品目录"
  defaultBranchColor="#ece9e1"
  defaultCaptionTop=""
  defaultCaptionMain="01 OrbitSpace · 02 Anvil · 03 Dropdrop"
>
  <section class="max-w-[1060px] mx-auto pt-4 pb-8">
    <header class="mb-8 border-b border-[var(--line-subtle)] pb-5 flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="font-mono-hud text-[11.5px] text-[var(--ink-dim)]">
          [作品目录 · 03]
        </div>
        <h1 class="mt-2 mb-0 font-display-serif text-[44px] sm:text-[54px] leading-none text-[#fcf8ef] phosphor-text">
          工程作品
        </h1>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        PROJECTS.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="hw-card group block p-5 no-underline text-inherit flex flex-col justify-between min-h-[330px]"
            style={`--branch-accent: ${project.accent};`}
          >
            <div>
              <div class="h-[3px] w-full mb-4 rounded-full opacity-90" style={`background: ${project.accent};`} />

              <div class="flex items-center justify-between font-mono-hud text-[11.5px]">
                <span style={`color: ${project.accent};`}>
                  <span class="font-pixel text-[10px]">[{project.index}]</span> {project.categoryLabel}
                </span>
              </div>

              <h2 class="mt-3 mb-1 font-display-serif text-[34px] leading-none text-[#fcf8ef] phosphor-text">
                {project.name}
              </h2>
              <div class="text-[13px] text-[var(--ink-dim)]">{project.subtitle}</div>

              <p class="mt-3.5 mb-0 text-[13.5px] leading-[1.75] text-[#dfdcd3]">
                {project.homePitch}
              </p>
            </div>

            <div class="mt-5 pt-3.5 border-t border-[var(--line-subtle)]">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {project.shortTags.map((tag) => (
                  <span class="px-2 py-0.5 text-[11px] rounded-sm border border-[var(--line-subtle)] text-[var(--ink-dim)] bg-[#121312]">
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-center justify-between font-mono-hud text-[11.5px]">
                <span class="text-[var(--ink-dim)]">#{project.commitHash}</span>
                <span
                  class="transition-transform duration-200 group-hover:translate-x-1"
                  style={`color: ${project.accent};`}
                >
                  查看详情 [→]
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</CrtLayout>
