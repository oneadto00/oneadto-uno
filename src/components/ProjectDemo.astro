---
interface Props {
  slug: 'orbitspace' | 'anvil' | 'dropdrop';
  accent: string;
}

const { slug, accent } = Astro.props;
---

<div
  class="hw-card p-4 sm:p-5 font-mono-hud text-[12px]"
  style={`--branch-accent: ${accent};`}
  data-project-demo={slug}
>
  {
    slug === 'orbitspace' && (
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-[var(--line-subtle)]">
          <span class="text-[#daff78]">[实时交互切片 · 轨道快照与全路径撤权]</span>
          <div class="flex items-center gap-3">
            <span id="os-epoch-badge" class="text-[11.5px] text-[var(--ink-dim)]">
              授权周期 v3 · 有效
            </span>
            <button id="os-revoke-btn" type="button" class="vcr-link text-[11.5px] text-[#ff4d3d]">
              [模拟移出撤权]
            </button>
          </div>
        </div>

        <div class="mt-4 overflow-x-auto">
          <svg viewBox="0 0 640 120" class="w-full min-w-[460px] h-[116px]">
            <path d="M 36 60 L 604 60" stroke="#ece9e1" stroke-opacity="0.28" stroke-width="3" stroke-linecap="round" />
            <path d="M 180 60 C 235 60, 255 28, 315 28 L 445 28 C 495 28, 515 60, 560 60" fill="none" stroke="#daff78" stroke-width="1.8" />

            <g class="os-node cursor-pointer" data-os-node="0">
              <circle cx="90" cy="60" r="14" fill="#ece9e1" fill-opacity="0.12" />
              <circle cx="90" cy="60" r="6.5" fill="#ece9e1" />
              <text x="90" y="92" text-anchor="middle" fill="#b8b4aa" font-size="10.5">基线提交</text>
            </g>
            <g class="os-node cursor-pointer" data-os-node="1">
              <circle cx="320" cy="28" r="16" fill="#daff78" fill-opacity="0.22" />
              <circle cx="320" cy="28" r="7.5" fill="#daff78" />
              <text x="320" y="13" text-anchor="middle" fill="#daff78" font-size="10.5">未提交快照 #04</text>
            </g>
            <g class="os-node cursor-pointer" data-os-node="2">
              <circle cx="445" cy="28" r="16" fill="#daff78" fill-opacity="0.22" />
              <circle cx="445" cy="28" r="7.5" fill="#daff78" />
              <text x="445" y="13" text-anchor="middle" fill="#daff78" font-size="10.5">行级批注讨论</text>
            </g>
            <g class="os-node cursor-pointer" data-os-node="3">
              <circle cx="560" cy="60" r="14" fill="#ece9e1" fill-opacity="0.12" />
              <circle cx="560" cy="60" r="6.5" fill="#ece9e1" />
              <text x="560" y="92" text-anchor="middle" fill="#b8b4aa" font-size="10.5">已合入主干</text>
            </g>
          </svg>
        </div>

        <div
          id="os-inspector"
          class="mt-2 p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)] text-[12.5px] leading-[1.68]"
          style="font-family: var(--font-sans);"
        >
          <div class="font-mono-hud text-[11px] text-[#daff78]">
            [未提交快照 #04] · 数据等级：仅补丁 · 采集序号：14
          </div>
          <p class="mt-1 mb-0 text-[#dfdcd3]">
            命令行完成设备流授权与密钥扫描并锁定载荷后上传；内容清单严格区分「未共享」与「已删除」，群聊引用永久指向该不可变快照。点击上方圆球可切换节点详情。
          </p>
        </div>
      </div>
    )
  }

  {
    slug === 'anvil' && (
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-[var(--line-subtle)]">
          <span class="text-[#22d3ee]">[实时交互切片 · 60 帧终端拓扑编排]</span>
          <div class="flex items-center gap-3">
            <button id="anvil-run-btn" type="button" class="vcr-link text-[11.5px] text-[#22d3ee]">
              [模拟波次启动]
            </button>
            <button id="anvil-conflict-btn" type="button" class="vcr-link text-[11.5px] text-[#facc15]">
              [模拟端口冲突]
            </button>
          </div>
        </div>

        <div class="mt-3.5 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)] space-y-2">
            <div class="text-[11px] text-[var(--ink-dim)]">服务依赖拓扑（波次调度）</div>
            <div class="flex items-center justify-between" data-anvil-svc="postgres">
              <span>├─ 数据库容器 :5432</span>
              <span class="anvil-badge text-[#4ade80]">[就绪运行]</span>
            </div>
            <div class="flex items-center justify-between" data-anvil-svc="api">
              <span>├─ 核心网关 :8080</span>
              <span class="anvil-badge text-[#4ade80]">[就绪运行]</span>
            </div>
            <div class="flex items-center justify-between" data-anvil-svc="web">
              <span>└─ 前端工作台 :3000</span>
              <span class="anvil-badge text-[#4ade80]">[就绪运行]</span>
            </div>
          </div>

          <div class="p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)]">
            <div class="flex items-center justify-between text-[11px] text-[var(--ink-dim)] mb-1.5">
              <span>日志流（16ms 批聚合）</span>
              <button id="anvil-kill-btn" type="button" class="hidden vcr-link text-[11px] text-[#ff4d3d]">
                [一键释放并重试]
              </button>
            </div>
            <div
              id="anvil-log"
              class="space-y-1 text-[11.5px] leading-[1.58] text-[#d6d3ca] min-h-[78px]"
              style="font-family: var(--font-sans);"
            >
              <div>[数据库] 5432 端口 TCP 就绪探针通过（14ms）</div>
              <div>[核心网关] 密钥已零明文注入内存，日志自动脱敏为 [已隐藏]</div>
              <div>[前端工作台] 命中日志正则，全量波次启动完成</div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    slug === 'dropdrop' && (
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-[var(--line-subtle)]">
          <span class="text-[#ff4d3d]">[实时交互切片 · 六位取件码与原子配额]</span>
          <div class="flex items-center gap-3">
            <button id="dd-new-btn" type="button" class="vcr-link text-[11.5px] text-[#ece9e1]">
              [生成新批次]
            </button>
            <button id="dd-pull-btn" type="button" class="vcr-link text-[11.5px] text-[#ff4d3d]">
              [模拟接收下载]
            </button>
          </div>
        </div>

        <div class="mt-3.5 grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)]">
            <div class="text-[11px] text-[var(--ink-dim)]">六位取件码</div>
            <div id="dd-code" class="mt-1 font-pixel text-[20px] tracking-[0.16em] text-[#fcf8ef]">
              482-915
            </div>
            <div class="mt-1 text-[11px] text-[var(--ink-dim)]">摘要校验 · 1 GiB 磁盘预留</div>
          </div>

          <div class="p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)]">
            <div class="text-[11px] text-[var(--ink-dim)]">会话级下载配额</div>
            <div id="dd-quota" class="mt-1 text-[17px] text-[#ff4d3d]">剩余 2 / 2 次</div>
            <div id="dd-state" class="mt-1 text-[11px] text-[#4ade80]">就绪 · 支持断点续传</div>
          </div>

          <div class="p-3 rounded bg-[#0c0d0c] border border-[var(--line-subtle)]">
            <div class="text-[11px] text-[var(--ink-dim)]">事务状态日志</div>
            <div
              id="dd-log"
              class="mt-1 text-[11.5px] leading-[1.58] text-[#d6d3ca]"
              style="font-family: var(--font-sans);"
            >
              SHA-256 校验就绪。点击上方「模拟接收下载」观察原子扣减与自动销毁流程。
            </div>
          </div>
        </div>
      </div>
    )
  }
</div>

<script>
  import { playSound } from '@/lib/sound';

  function initProjectDemos() {
    const box = document.querySelector<HTMLElement>('[data-project-demo]');
    if (!box) return;
    const slug = box.dataset.projectDemo;
    const timers: number[] = [];

    if (slug === 'orbitspace') {
      const nodes = [
        {
          head: '[基线提交] · 数据等级：完整代码树',
          body: '完整基线提交已归档至对象存储，前端由 Web Worker 完成泳道拓扑布局与视口虚拟化渲染。',
        },
        {
          head: '[未提交快照 #04] · 数据等级：仅补丁 · 采集序号：14',
          body: '命令行完成设备流授权与密钥扫描并锁定载荷后上传；内容清单严格区分「未共享」与「已删除」，群聊引用永久指向该不可变快照。',
        },
        {
          head: '[行级批注讨论] · 结论流转：待处理 → 已解决',
          body: '支持对具体代码行发起批注与结论沉淀；群聊在同事务内加锁分配双序号，断线后可凭双游标无损补拉。',
        },
        {
          head: '[已合入主干] · 异步解析防复活校验',
          body: '远端同步与文档解析在受控沙箱内执行以防 SSRF；结果回写前执行四重版本校验，杜绝迟到任务覆盖新状态。',
        },
      ];

      const inspector = document.getElementById('os-inspector');
      const epochBadge = document.getElementById('os-epoch-badge');
      const revokeBtn = document.getElementById('os-revoke-btn');
      let revoked = false;

      box.querySelectorAll<SVGGElement>('.os-node').forEach((node) => {
        node.addEventListener('click', () => {
          if (revoked) {
            playSound('alert');
            return;
          }
          playSound('action');
          const idx = Number(node.dataset.osNode || 0);
          const item = nodes[idx];
          if (inspector && item) {
            inspector.innerHTML = `<div class="font-mono-hud text-[11px] text-[#daff78]">${item.head}</div><p class="mt-1 mb-0 text-[#dfdcd3]">${item.body}</p>`;
          }
        });
      });

      revokeBtn?.addEventListener('click', () => {
        revoked = !revoked;
        playSound(revoked ? 'alert' : 'confirm');
        if (epochBadge) {
          epochBadge.textContent = revoked ? '授权周期 v4 · 已撤权' : '授权周期 v3 · 有效';
          epochBadge.style.color = revoked ? '#ff4d3d' : '';
        }
        if (revokeBtn) {
          revokeBtn.textContent = revoked ? '[恢复正常视图]' : '[模拟移出撤权]';
        }
        if (inspector) {
          inspector.innerHTML = revoked
            ? `<div class="font-mono-hud text-[11px] text-[#ff4d3d]">[403 权限失效] · 授权周期递增至 v4</div><p class="mt-1 mb-0 text-[#dfdcd3]">本地消息表联动 Redis 广播，瞬间切断该成员的接口请求、实时群聊、命令行凭证与历史快照读取路径。</p>`
            : `<div class="font-mono-hud text-[11px] text-[#daff78]">${nodes[1].head}</div><p class="mt-1 mb-0 text-[#dfdcd3]">${nodes[1].body}</p>`;
        }
      });
    }

    if (slug === 'anvil') {
      const logEl = document.getElementById('anvil-log');
      const killBtn = document.getElementById('anvil-kill-btn');
      const setSvc = (name: string, text: string, color: string) => {
        const badge = box.querySelector<HTMLElement>(`[data-anvil-svc="${name}"] .anvil-badge`);
        if (badge) {
          badge.textContent = text;
          badge.style.color = color;
        }
      };
      const setLogs = (lines: string[]) => {
        if (!logEl) return;
        logEl.innerHTML = lines.map((l) => `<div>${l}</div>`).join('');
      };

      const runUp = () => {
        playSound('action');
        timers.forEach((t) => window.clearTimeout(t));
        killBtn?.classList.add('hidden');
        setSvc('postgres', '[端口探测中]', '#22d3ee');
        setSvc('api', '[等待上游]', '#facc15');
        setSvc('web', '[等待上游]', '#facc15');
        setLogs(['[调度器] 波次 0：正在拉起数据库容器...']);

        timers.push(
          window.setTimeout(() => {
            playSound('hover');
            setSvc('postgres', '[就绪运行]', '#4ade80');
            setSvc('api', '[接口探测中]', '#22d3ee');
            setLogs([
              '[数据库] 5432 端口 TCP 探针通过（12ms）',
              '[核心网关] 密钥已安全注入子进程内存，日志自动脱敏为 [已隐藏]',
            ]);
          }, 550)
        );
        timers.push(
          window.setTimeout(() => {
            playSound('hover');
            setSvc('api', '[就绪运行]', '#4ade80');
            setSvc('web', '[日志探测中]', '#22d3ee');
            setLogs([
              '[数据库] 5432 端口 TCP 探针通过（12ms）',
              '[核心网关] 健康检查接口返回 200 OK',
              '[前端工作台] 等待服务启动日志正则匹配...',
            ]);
          }, 1150)
        );
        timers.push(
          window.setTimeout(() => {
            playSound('confirm');
            setSvc('web', '[就绪运行]', '#4ade80');
            setLogs([
              '[核心网关] 健康检查接口返回 200 OK',
              '[前端工作台] 命中就绪正则，全部 3 项服务进入运行态',
              '[系统容灾] 进程组时间戳指纹已落盘，防孤儿进程保护已开启',
            ]);
          }, 1700)
        );
      };

      document.getElementById('anvil-run-btn')?.addEventListener('click', runUp);
      document.getElementById('anvil-conflict-btn')?.addEventListener('click', () => {
        playSound('alert');
        timers.forEach((t) => window.clearTimeout(t));
        setSvc('postgres', '[就绪运行]', '#4ade80');
        setSvc('api', '[端口冲突]', '#ff4d3d');
        setSvc('web', '[等待上游]', '#facc15');
        killBtn?.classList.remove('hidden');
        setLogs([
          '[系统预检] 端口 8080 绑定失败，触发两阶段占用反查',
          '[占用详情] 外部进程 PID 48219（残留旧服务进程）',
          '[交互救援] 点击上方「一键释放并重试」终止占用并恢复调度',
        ]);
      });
      killBtn?.addEventListener('click', () => {
        playSound('action');
        setLogs(['[系统容灾] 已向 PID 48219 发送终止信号，正在重新启动核心网关...']);
        timers.push(window.setTimeout(runUp, 420));
      });
    }

    if (slug === 'dropdrop') {
      let remaining = 2;
      const codeEl = document.getElementById('dd-code');
      const quotaEl = document.getElementById('dd-quota');
      const stateEl = document.getElementById('dd-state');
      const logEl = document.getElementById('dd-log');

      const render = (msg: string) => {
        if (quotaEl) quotaEl.textContent = `剩余 ${remaining} / 2 次`;
        if (stateEl) {
          stateEl.textContent = remaining > 0 ? '就绪 · 支持断点续传' : '名额耗尽 · 已自动销毁';
          stateEl.style.color = remaining > 0 ? '#4ade80' : '#ff4d3d';
        }
        if (logEl) logEl.textContent = msg;
      };

      document.getElementById('dd-pull-btn')?.addEventListener('click', () => {
        if (remaining > 1) {
          playSound('action');
          remaining -= 1;
          render('SQLite WAL 短事务原子扣减 1 个会话名额；同一会话后续断点续传不重复扣费。');
        } else if (remaining === 1) {
          playSound('alert');
          remaining = 0;
          render('名额归零且传输收尾：服务已自动销毁暂存文件与元数据，仅保留 24 小时失效摘要提示。');
        } else {
          playSound('alert');
          render('新接收请求已被原子拦截并提示「无下载名额」；点击「生成新批次」可重新演示。');
        }
      });

      document.getElementById('dd-new-btn')?.addEventListener('click', () => {
        playSound('confirm');
        remaining = 2;
        const a = Math.floor(100 + Math.random() * 900);
        const b = Math.floor(100 + Math.random() * 900);
        if (codeEl) codeEl.textContent = `${a}-${b}`;
        render('新批次流式落盘完成，已校验磁盘剩余空间大于 1 GiB 预留护栏，等待局域网设备提取。');
      });
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        timers.forEach((t) => window.clearTimeout(t));
      },
      { once: true }
    );
  }

  document.addEventListener('astro:page-load', initProjectDemos);
</script>
